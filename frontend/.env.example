# ==============================================================================
# FleetCore Enterprise — Frontend Runtime Environment Configuration (.env.example)
# Copy this file to .env.local for local development or set in your cloud hosting provider
# (Vercel, AWS Amplify, Cloudflare Pages, Docker, Kubernetes)
# ==============================================================================

# REST API Base URL (Spring Boot core-api)
# Local: http://localhost:8081 | Production: https://api.fleetcore.io
NEXT_PUBLIC_API_URL=http://localhost:8081

# Real-Time Telemetry WebSocket Hub (Go Ingestion / Spring Boot)
# Local: ws://localhost:8080/ws/telemetry | Production: wss://stream.fleetcore.io/ws/telemetry
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/telemetry

# Python AI & High-Precision Mathematical Sidecar Service
# Local: http://localhost:8098 | Production: https://ai.fleetcore.io
NEXT_PUBLIC_AI_SIDECAR_URL=http://localhost:8098

# Mapbox GL Public Vector Tile Access Token (Optional: Leave empty for fallback vector grid)
NEXT_PUBLIC_MAPBOX_TOKEN=
