# ==============================================================================
# FleetCore Enterprise — Global Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file: `cp .env.example .env`
# 2. Update the credentials below with your secure environment secrets.
# 3. NEVER commit the resulting `.env` file to version control (protected by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL 16 + TimescaleDB + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_DB=fleetcore_db
POSTGRES_USER=fleetcore_admin
# Database master password (CHANGE THIS BEFORE DEPLOYMENT)
POSTGRES_PASSWORD=CHANGE_ME_SUPER_STRONG_DATABASE_PASSWORD_2026!
POSTGRES_PORT=5433
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/fleetcore_db

# ------------------------------------------------------------------------------
# 2. REDIS L2 CACHE & DISTRIBUTED RATE LIMITING
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DATABASE=0

# ------------------------------------------------------------------------------
# 3. KAFKA TELEMETRY INGESTION STREAM
# ------------------------------------------------------------------------------
KAFKA_BROKER=localhost:9093
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_TOPIC=telemetry.raw
TCP_PORT=9095
UDP_PORT=9096

# ------------------------------------------------------------------------------
# 4. CORE API (Spring Boot 3.2 on Port 8081)
# ------------------------------------------------------------------------------
CORE_API_PORT=8081
# JWT Signing Key — MUST be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_CRYPTOGRAPHIC_JWT_KEY!
JWT_EXPIRATION_MS=86400000

# Webhook & ERP HMAC SHA-256 Signing Key (SAP / NetSuite)
ERP_WEBHOOK_SECRET=CHANGE_ME_SECURE_ERP_INTEGRATION_WEBHOOK_KEY_2026

# CORS & WebSocket Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEBSOCKET_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 5. PYTHON AI & HIGH-PRECISION MATHEMATICAL SIDECAR (Port 8098)
# ------------------------------------------------------------------------------
AI_SIDECAR_PORT=8098
AI_SIDECAR_URL=http://localhost:8098/api/v1/stretch/ai
IRIDIUM_SBD_URL=http://localhost:8098/api/v1/stretch/iridium

# ------------------------------------------------------------------------------
# 6. FRONTEND (Next.js 14 App Router on Port 3000)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/telemetry
NEXT_PUBLIC_AI_SIDECAR_URL=http://localhost:8098
# Optional Mapbox GL Vector Tile Access Token
NEXT_PUBLIC_MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY (Datadog APM & Metrics)
# ------------------------------------------------------------------------------
DD_API_KEY=
ENVIRONMENT=production
