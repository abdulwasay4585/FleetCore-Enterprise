# ==============================================================================
# FleetCore Enterprise — Infrastructure Stack Environment Variables (.env.example)
# Copy to .env in this directory before running `docker-compose up -d`
# ==============================================================================

# Database Credentials (REQUIRED)
# Choose a strong password (minimum 16 characters recommended)
POSTGRES_DB=fleetcore_db
POSTGRES_USER=fleetcore_admin
POSTGRES_PASSWORD=CHANGE_ME_SUPER_STRONG_DATABASE_PASSWORD_2026!
POSTGRES_PORT=5433

# Redis L2 Cache & Rate Limiting
REDIS_PORT=6380
REDIS_PASSWORD=

# Kafka Streaming Broker Host
KAFKA_HOST=localhost

# Core API Security & JWT (REQUIRED)
# Must be at least 32 characters (256 bits) for HMAC-SHA256 signing
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_CRYPTOGRAPHIC_JWT_KEY!
CORE_API_PORT=8081

# ERP Webhook HMAC Signing Key
ERP_WEBHOOK_SECRET=CHANGE_ME_SECURE_ERP_INTEGRATION_WEBHOOK_KEY_2026

# AI Sidecar
AI_SIDECAR_PORT=8098

# Frontend Web Application
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/telemetry
NEXT_PUBLIC_AI_SIDECAR_URL=http://localhost:8098
NEXT_PUBLIC_MAPBOX_TOKEN=

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
